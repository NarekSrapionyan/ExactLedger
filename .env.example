# Local development only. Copy to .env (gitignored) and choose separate passwords.
# Use generated letters/digits/_/- passwords to avoid Compose/connection-string escaping.
POSTGRES_PASSWORD=local_bootstrap_change_me
MIGRATION_PASSWORD=local_migrations_change_me
APP_PASSWORD=local_app_change_me
SEED_PASSWORD=local_identities_change_me
# Generate a random base64 key; the API rejects this placeholder.
JWT_SIGNING_KEY=replace_with_base64_of_32_random_bytes

# Change these if another local service already uses the port.
POSTGRES_PORT=5432
API_PORT=8080

# Automatic daily clearing and due-escrow release. Set false for a manually controlled demo.
CLEARING_SCHEDULE_ENABLED=true
ESCROW_SCHEDULE_ENABLED=true
ESCROW_INTERVAL_SECONDS=60
