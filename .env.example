# Local development only. Copy to .env (gitignored) and choose separate passwords.
# Use generated letters/digits/_/- passwords to avoid Compose/connection-string escaping.
POSTGRES_PASSWORD=local_bootstrap_change_me
MIGRATION_PASSWORD=local_migrations_change_me
APP_PASSWORD=local_app_change_me

# Change these if another local service already uses the port.
POSTGRES_PORT=5432
API_PORT=8080
