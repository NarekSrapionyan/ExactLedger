<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>ExactLedger-el.Api-8025a407-6c86-4be8-9c87-d8794a1a54d1</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Document HTTP contracts without requiring comments on every public helper. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Override the vulnerable 2.0.0 dependency (GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" />
    <!-- Design-time only: lets dotnet-ef use the API as startup project. Not deployed. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\el.Application\el.Application.csproj" />
    <ProjectReference Include="..\el.Infrastructure\el.Infrastructure.csproj" />
  </ItemGroup>

</Project>
